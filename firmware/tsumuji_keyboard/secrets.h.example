// Copy this file to secrets.h and fill in the pairing key.
// secrets.h is git-ignored. NEVER commit the real key.
//
// Generate a key on the Mac with:
//   openssl rand -hex 32
// and store the same value in the Keychain for the helper:
//   tsumuji-helper pair <hex>
#pragma once
#include <stdint.h>

// 32-byte pre-shared pairing key. Unused in plaintext bring-up mode.
static const uint8_t PAIRING_KEY[32] = {
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
};
